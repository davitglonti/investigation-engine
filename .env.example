# LLM Configuration
LLM_PROVIDER=google  # options: google, openai, groq
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model Settings
PRIMARY_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Vector DB Settings
VECTOR_DB_TYPE=chroma  # options: chroma, qdrant
CHROMA_PERSIST_DIR=./chroma_db
QDRANT_URL=
QDRANT_API_KEY=

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501

# System Settings
LOG_LEVEL=INFO
